# Copy this file to .env (same folder) and fill in your own values locally.
# .env is ignored by Git. Never commit real connection strings or passwords.

# Which mode to run:
#   demo  = fictional data kept in the browser; no database, API switched off
#   mongo = Express API + MongoDB with sign-in; refuses to start if MongoDB can't be reached
# If APP_MODE is empty: mongo when MONGODB_URI is set, otherwise demo.
APP_MODE=demo

# MongoDB connection string (needed only for APP_MODE=mongo). Placeholders - replace with your own:
#   local MongoDB:  mongodb://127.0.0.1:27017/blackhouse_preview
#   MongoDB Atlas:  mongodb+srv://<username>:<password>@<cluster-host>/blackhouse_preview?retryWrites=true&w=majority
MONGODB_URI=

# ---------------------------------------------------------------------------
# Integrations (MongoDB mode only; ignored in demo mode). Leave empty for "Not connected".
# Read-only unless switched on: MONDAY_WRITES (allowlisted Monday updates), RESPOND_SENDS (Upselling sends). No webhooks.
# NOTE: real tokens + board IDs show REAL customer data on this computer. Keep them empty until you decide to.

# Monday.com API token (Monday: avatar → Developers → My access tokens). Same name as the Apps Script property.
MONDAY_TOKEN=
# Board IDs to read. Each board is optional; the original portal used (Code.gs CONFIG):
#   Direct Clients 2001153190 · Listings 2004661102 · Calendar 2001153191
MONDAY_LEADS_BOARD_ID=
MONDAY_LISTINGS_BOARD_ID=
MONDAY_CALENDAR_BOARD_ID=
# Allowlisted Monday updates (Inventory Availability; Manager-only lead Budget, Move-in, Inquiry Type, Nationality), each one
# confirmed by the user. Leave empty (off): Monday stays read-only. "on" enables them; see README "Monday updates".
MONDAY_WRITES=
# Optional: a Calendar-board text column id that also receives a viewing's broker feedback (unset: kept in the portal only).
MONDAY_CALENDAR_FEEDBACK_COLUMN=
# Optional: Monday update attempts per user per minute (1-60, default 10; the whole server allows 3x that).
MONDAY_WRITE_LIMIT=

# respond.io API token (respond.io: Settings → Integrations → Developer API). Same name as the Apps Script property.
RESPOND_TOKEN=
# Workspace (space) ID: the number in app.respond.io/space/<ID>/... . Message Lead / Call on respond.io (lead drawer)
# and "Open in respond.io" links open a lead's conversation with it; unset, they explain that it's missing.
RESPOND_SPACE_ID=
# Optional: "on" checks the last 15 messages of every visible lead for reply status / Temperature. Off by default:
# respond.io is then read only when someone opens a lead's Chat tab, and other leads show "Unchecked".
RESPOND_LIST_CHECKS=

# ---------------------------------------------------------------------------
# KPI Review (MongoDB mode): the Team & Access email of each reviewer. Only these two accounts can open KPI Review
# or read its coaching and feedback (Managers can't). Each must also be an active member in Settings → Team & Access,
# and on a Google server signed in with that Google account. Empty = that reviewer isn't set up yet.
# blackhouse2br@gmail.com is refused here. Placeholders: put Toby's and Jonjo's own addresses.
KPI_REVIEWER_TOBY_EMAIL=
KPI_REVIEWER_JONJO_EMAIL=

# Upselling: "on" lets Upselling send 1:1 messages and tag contacts through respond.io, each batch confirmed by the
# operator after reviewing the recipients. Empty (off): drafts, audiences, previews and the CSV work; nothing is sent.
# RESPOND_TOKEN must then be allowed to send messages and tag contacts. The same switch lets Service Requests send a
# reviewed request to a supplier's respond.io contact, and LOI signing links go to a client on respond.io.
RESPOND_SENDS=
# A controlled first test: up to 10 respond.io contact IDs (digits, comma-separated). While set, every respond.io send
# and tag goes only to these contacts (everyone else is left out before anything is recorded), and only a Manager can
# send. Remove it after the test.
RESPOND_SEND_ONLY_TO=

# ---------------------------------------------------------------------------
# LOI e-signature and deal files (optional; each part that isn't set shows what it needs instead)
# Where the files go: EITHER a Google account's My Drive (no Shared drives needed) OR a Shared Drive, not both.
#
# My Drive: "on", then a Manager connects the Google account in Settings → Files (Google's consent screen; the portal
# asks only for drive.file: it sees nothing in that Drive but the "Blackhouse Portal" folders it makes). Uses the
# sign-in OAuth client (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET) unless the two variables below name another one; add
# <PUBLIC_API_URL>/api/drive/oauth/callback to that client's authorized redirect URIs.
GOOGLE_DRIVE_OAUTH=
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# 32 random bytes (base64 or hex) that encrypt the stored Google refresh token. Keep it: changing it means
# reconnecting. Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_DRIVE_TOKEN_KEY=
#
# Shared Drive: a Google Cloud service account (separate from the read-only one below) that is a Content manager of a
# folder in a Shared Drive. A My Drive folder shared with a service account can't take uploads (it has no storage).
# The whole JSON key, or base64 of it.
GOOGLE_DRIVE_WRITER_SERVICE_ACCOUNT_JSON=
# Shared Drive only (My Drive storage makes its own folders): folder IDs (the part after /folders/ in the folder's
# link): signed LOIs and their PDFs; deal files (signed contracts, deposit slips, renewal contracts)
GOOGLE_DRIVE_LOI_FOLDER_ID=
GOOGLE_DRIVE_DEALS_FOLDER_ID=
# "on" lets staff create LOI signing links (one use, expiring after LOI_SIGN_TTL_DAYS, default 14).
LOI_SIGNING=
LOI_SIGN_TTL_DAYS=
# Keeps signing pages valid across restarts (any long random text). Unset: a new key at each start, so open pages
# must be reloaded after a restart. At least 32 random characters; required in production when LOI_SIGNING=on.
LOI_SIGN_SECRET=
# PDF of the LOI: drive (Google Drive's converter, as the Apps Script) | gotenberg (a LibreOffice service at
# GOTENBERG_URL) | none (signers read the document text on the page; the signed copy is a .docx)
LOI_PDF_CONVERTER=
GOTENBERG_URL=
# Email for LOI signing links and the Upselling "send test to me": port 465 (implicit TLS, the default) or 587 (STARTTLS)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Project Pages (optional; the pages, units and uploads work without these)
# Read-only Google Drive for "Add from Drive" / "Build from Google Drive": a Google Cloud service account's JSON key
# (the whole JSON, or base64 of it). Share each project folder with the service account's email as Viewer.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Reads the folder's documents for "Build from Google Drive" (Claude), and client replies for Service Requests
# ("Check replies"). Without it, Build only adds the folder's media and Check replies only finds the offers.
ANTHROPIC_API_KEY=

# Local server address. Keep 127.0.0.1 so only this computer can open the app.
HOST=127.0.0.1
PORT=4173

# How long a sign-in lasts, in hours (mongo mode).
SESSION_HOURS=12

# ---------------------------------------------------------------------------
# Hosted setup only (Railway). Leave these empty for the local preview.
# On Railway, set them as service Variables in the Railway dashboard - never in this file, the page, or GitHub.
# Full list and steps: DEPLOYMENT.md.
#   AUTH_PROVIDER      password (local preview only) | google (required when HOST is not 127.0.0.1)
#   PUBLIC_API_URL     the Railway app's public address, e.g. https://<service>.up.railway.app (no path)
#   PORTAL_URL         leave EMPTY when Railway serves the page too (the current setup). Only for a page hosted
#                      elsewhere on a domain you own; *.github.io + *.up.railway.app is refused
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET   from Google Cloud Console (OAuth client, "Web application")
#   GOOGLE_ALLOWED_DOMAIN                     optional: only Google Workspace accounts of this domain
AUTH_PROVIDER=
PUBLIC_API_URL=
PORTAL_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=

# ---------------------------------------------------------------------------
# Production (NODE_ENV=production on the hosted server only; see DEPLOYMENT.md "Before production"). Set exactly
# DEPLOYMENT.md-before-production-v1 once every item of that checklist has passed on the staging run.
PRODUCTION_CHECKLIST_ACK=
